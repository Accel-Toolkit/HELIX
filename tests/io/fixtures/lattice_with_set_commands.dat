; Synthetic lattice exercising every supported SET_*/ADJUST_* command.
; Used by tests/elements/test_lattice_commands.py for round-trip checks.
FREQ 162.5

; --- input-side ADJUST_BEAM_* (must precede first lattice element) ---
ADJUST_BEAM_TWISS    1 1 1 1 0 1 1
ADJUST_BEAM_CENTROID 1 0 0 1 1 0 0
ADJUST_BEAM_EMIT     1 1 1 0
ADJUST_BEAM_CURRENT  1 1

; --- run-time-active commands ---
SET_BEAM_ENERGY      1 2.5
SET_BEAM_E0_P0       1 0.1 -3.0 1 1
SET_BEAM_PHASE_ERROR 5.0 0
SET_GAUSSIAN_CUT_OFF 4.0
SET_SYNC_PHASE

; --- minimal optics so the lattice has length ---
DRIFT 100 5
QUAD  50 12.0 5
DRIFT 100 5

; --- passive constraint markers consumed by the matcher ---
SET_TWISS    QUAD1 1.2 0.8 -1.0 0.6 0.0 1.0 1 1 1 1 0 0
SET_POSITION 1 0 0 0 0
SET_ACHROMAT 1 1 1 0
SET_SIZE     1 5.0 5.0 30.0 0
SET_SIZE_MAX 1 3 6.0 6.0 45.0 1
SET_SIZE_MIN 1 3 0.5 0.5 1.0 1
SET_BEAM_PHASE_ADV 1 4 60.0 60.0 30.0
SET_SEPARATION 1 2.0 2.0
SET_ADV 90.0 90.0

; --- ADJUST family ---
ADJUST            QUAD 2 1 -20 20 0.5 0
ADJUST_STEERER    1 0.05 0.001
ADJUST_STEERER_BX 1 0.05 0.001
ADJUST_STEERER_BY 1 0.05 0.001

END
