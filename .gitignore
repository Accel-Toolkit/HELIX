docs/manual/_build/figures/*.png
!docs/manual/_build/figures/gui/

# Matcher output artifacts (regenerable by re-running the match)
*.matched.dat


# Example analysis outputs (regenerable by re-running the example scripts)
examples/**/*.png
examples/**/*.h5

# Multi-objective example generated front
examples/**/pareto.csv

# Third-party field-map data (ANL / CEA origin) — must NOT be shipped
/Fields/

# TraceWin reference data / outputs (external, not part of the codebase)
/Tracewin_code/
/TraceWIn_Tools/

