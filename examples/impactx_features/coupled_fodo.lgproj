{
  "__kind__": "linac_gen_project",
  "__version__": 1,
  "lattice_path": "coupled_fodo.dat",
  "beam": {
    "species": "proton",
    "energy": 10.0,
    "frequency": 325.0,
    "current": 20.0,
    "duty_cycle": 100.0,
    "n_particles": 50000,
    "distribution": "thermal",
    "cutoff": 4.0,
    "halo_fraction": 0.05,
    "halo_ratio": 6.0,
    "emit_nx": 0.25,
    "alpha_x": 0.0,
    "beta_x": 2.0,
    "emit_ny": 0.25,
    "alpha_y": 0.0,
    "beta_y": 2.0,
    "emit_z": 0.30,
    "alpha_z": 0.0,
    "beta_z": 3.0,
    "centroid_x": 0.0,
    "centroid_xp": 0.0,
    "centroid_y": 0.0,
    "centroid_yp": 0.0,
    "centroid_dphi": 0.0,
    "centroid_dw": 0.0,
    "mismatch_x": 0.0,
    "mismatch_y": 0.0,
    "mismatch_z": 0.0,
    "source": "generate",
    "distribution_file": null,
    "continuous": false,
    "dc_energy_spread_keV": 0.0
  },
  "convergence": {
    "step1_per_m": 100.0,
    "step2_per_m": 50.0,
    "grid_nx": 32,
    "grid_extent_sigma": 6.0,
    "backend": "auto",
    "green_kind": "igf",
    "kernel": "tsc",
    "grid_mode": "fixed",
    "dc_kernel": "uniform",
    "integrator_kind": "kd",
    "interp_kind": "linear",
    "env_solver": "matrix",
    "record_substeps": false,
    "record_density": false
  }
}
