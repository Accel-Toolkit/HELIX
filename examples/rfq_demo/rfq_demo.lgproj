{
  "__kind__": "linac_gen_project",
  "__version__": 1,
  "lattice_path": "rfq_demo.dat",
  "beam": {
    "species": "proton",
    "energy": 0.075,
    "frequency": 352.21,
    "current": 15.0,
    "duty_cycle": 100.0,
    "n_particles": 20000,
    "distribution": "gaussian",
    "cutoff": 4.0,
    "emit_nx": 0.2,
    "alpha_x": 0.0,
    "beta_x": 0.01,
    "emit_ny": 0.2,
    "alpha_y": 0.0,
    "beta_y": 0.01,
    "emit_z": 0.0,
    "alpha_z": 0.0,
    "beta_z": 1.0,
    "centroid_x": 0.0,
    "centroid_xp": 0.0,
    "centroid_y": 0.0,
    "centroid_yp": 0.0,
    "centroid_dphi": 0.0,
    "centroid_dw": 0.0,
    "mismatch_x": 0.0,
    "mismatch_y": 0.0,
    "mismatch_z": 0.0,
    "source": "generate",
    "distribution_file": null,
    "continuous": true,
    "dc_energy_spread_keV": 0.0,
    "periodic_phase": true
  },
  "convergence": {
    "step1_per_m": 100.0,
    "step2_per_m": 100.0,
    "nx": 32,
    "ny": 32,
    "nz": 32,
    "grid_extent_sigma": 6.0,
    "backend": "auto",
    "green_kind": "igf",
    "kernel": "tsc",
    "grid_mode": "adaptive",
    "dc_kernel": "uniform",
    "integrator_kind": "kd",
    "interp_kind": "linear",
    "env_solver": "matrix",
    "record_substeps": false,
    "record_density": false
  }
}
